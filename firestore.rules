rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // نتائج الامتحانات: كل طالب يقرأ نتائجه فقط، والتعديل والحذف ممنوع
    match /results/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','student','course','courseName','correct','total','percentage','passed','date','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.student is string
        && request.resource.data.student.size() <= 60
        && request.resource.data.course in ['htmlcss','javascript']
        && request.resource.data.total is int
        && request.resource.data.total > 0 && request.resource.data.total <= 50
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0 && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.percentage is int
        && request.resource.data.percentage >= 0 && request.resource.data.percentage <= 100
        && request.resource.data.passed == (request.resource.data.percentage >= 60)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // الفيدباك: القراءة للجميع، الكتابة للمسجّلين فقط، بدون تعديل أو حذف
    match /feedbacks/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','name','course','rating','comment','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.course in ['HTML & CSS','JavaScript']
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 10 && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
